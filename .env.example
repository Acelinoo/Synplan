# =============================================================================
# Synplan Environment Variables Configuration Template
# =============================================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit your .env file to version control.

# =============================================================================
# DATABASE (Supabase PostgreSQL)
# =============================================================================
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# =============================================================================
# APPLICATION
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# =============================================================================
# GOOGLE OAUTH 2.0
# Callback URL: ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google
# =============================================================================
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# =============================================================================
# GITHUB OAUTH APP
# Callback URL: ${NEXT_PUBLIC_APP_URL}/api/auth/callback/github
# =============================================================================
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# =============================================================================
# SUPABASE (Realtime & WebSocket)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# =============================================================================
# AI ASSISTANT PROVIDER
# =============================================================================
AI_API_KEY="your-openai-or-gemini-key"
AI_MODEL="gpt-4o-mini"
AI_API_URL="https://api.openai.com/v1/chat/completions"

# =============================================================================
# TEST-ONLY VARIABLES (DO NOT SET IN PRODUCTION)
# These variables are STRICTLY for automated test suites only.
# Setting these in production is a SECURITY RISK.
# =============================================================================
# ALLOW_TEST_HEADER_AUTH="true"   # Enables x-synplan-user-id header auth (TEST ONLY)
# DISABLE_RATE_LIMIT="true"      # Disables rate limiting (TEST ONLY)
