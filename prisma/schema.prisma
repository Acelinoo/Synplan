datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectRole {
  LEAD
  CONTRIBUTOR
  VIEWER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActorType {
  USER
  AI
  SYSTEM
}

enum ConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}

// =============================================================================
// 1. IDENTITY & AUTHENTICATION
// =============================================================================

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  avatarUrl        String?
  role             Role              @default(MEMBER)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  accounts         Account[]
  sessions         Session[]
  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  projectMembers   ProjectMember[]
  assignedTasks    Task[]            @relation("TaskAssignee")
  createdTasks     Task[]            @relation("TaskCreator")
  taskComments     TaskComment[]
  notifications    Notification[]
  auditLogs        AuditLog[]        @relation("UserAuditLogs")
  aiConversations  AiConversation[]
  aiConfirmations  AiConfirmationSession[]
  aiReceipts       AiExecutionReceipt[]

  @@index([email])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String   @default("oauth")
  provider          String   // "google" | "github"
  providerAccountId String
  refreshToken      String?  @db.Text
  accessToken       String?  @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

// =============================================================================
// 2. WORKSPACE & TENANCY
// =============================================================================

model Workspace {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  ownerId                String
  logoUrl                String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  owner                  User                    @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members                WorkspaceMember[]
  projects               Project[]
  phases                 Phase[]
  milestones             Milestone[]
  tasks                  Task[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  automationRules        AutomationRule[]
  aiConfirmations        AiConfirmationSession[]
  aiConversations        AiConversation[]
  aiReceipts             AiExecutionReceipt[]

  @@index([slug])
  @@index([ownerId])
}

model WorkspaceMember {
  id            String    @id @default(cuid())
  workspaceId   String
  userId        String
  role          Role      @default(MEMBER)
  workloadScore Int       @default(0) // 0-100% capacity
  joinedAt      DateTime  @default(now())

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
  @@index([userId])
}

// =============================================================================
// 3. PROJECT & SQUADS
// =============================================================================

model Project {
  id              String            @id @default(cuid())
  workspaceId     String
  name            String
  slug            String
  description     String?           @db.Text
  status          ProjectStatus     @default(ACTIVE)
  startDate       DateTime?
  targetDate      DateTime?
  deadline        DateTime?         // Backward compatibility with existing views
  completedAt     DateTime?
  color           String            @default("#6366F1")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members         ProjectMember[]
  phases          Phase[]
  milestones      Milestone[]
  tasks           Task[]
  automationRules AutomationRule[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(CONTRIBUTOR)
  joinedAt  DateTime    @default(now())

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Phase {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String
  name        String
  description String?   @db.Text
  order       Float     @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId, order])
  @@index([workspaceId])
}

model Milestone {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String
  title       String
  description String?   @db.Text
  targetDate  DateTime
  isReached   Boolean   @default(false)
  reachedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId, targetDate])
  @@index([workspaceId])
}

// =============================================================================
// 4. TASK & WORKFLOW MANAGEMENT
// =============================================================================

model Task {
  id             String           @id @default(cuid())
  workspaceId    String
  projectId      String
  phaseId        String?
  milestoneId    String?
  creatorId      String?
  assigneeId     String?

  title          String
  description    String?          @db.Text
  status         TaskStatus       @default(TODO)
  priority       TaskPriority     @default(MEDIUM)
  order          Float            @default(0) // Fractional midpoint ordering

  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  estimatedHours Float?
  actualHours    Float?
  tags           String[]         @default([])

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase          Phase?           @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  milestone      Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  creator        User?            @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  assignee       User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  subtasks       Subtask[]
  comments       TaskComment[]

  blockedBy      TaskDependency[] @relation("BlockedTask")
  blocking       TaskDependency[] @relation("BlockingTask")

  @@index([workspaceId, status])
  @@index([workspaceId, assigneeId, status])
  @@index([workspaceId, dueDate])
  @@index([projectId, status])
  @@index([projectId, phaseId])
  @@index([assigneeId, status])
  @@index([workspaceId, createdAt])
}

model TaskDependency {
  id             String   @id @default(cuid())
  blockingTaskId String
  blockedTaskId  String
  createdAt      DateTime @default(now())

  blockingTask   Task     @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  blockedTask    Task     @relation("BlockedTask", fields: [blockedTaskId], references: [id], onDelete: Cascade)

  @@unique([blockingTaskId, blockedTaskId])
  @@index([blockedTaskId])
  @@index([blockingTaskId])
}

model Subtask {
  id          String    @id @default(cuid())
  taskId      String
  title       String
  completed   Boolean   @default(false)
  order       Float     @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([authorId])
}

// =============================================================================
// 5. AUTOMATION, NOTIFICATION & AUDIT
// =============================================================================

model AutomationRule {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String?
  name        String
  isActive    Boolean   @default(true)
  triggerType String
  conditions  Json
  actions     Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, triggerType, isActive])
}

model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  title       String
  description String
  type        String    @default("info")
  link        String?
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([workspaceId, createdAt])
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String?
  actorType   ActorType @default(USER)
  action      String
  target      String    @default("")
  entityType  String?
  entityId    String?
  before      Json?
  after       Json?
  requestId   String?
  source      String?   @default("WEB")
  metadata    Json?
  ipAddress   String?
  timestamp   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?     @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, timestamp])
  @@index([workspaceId, entityType, timestamp])
  @@index([workspaceId, action, timestamp])
  @@index([workspaceId, actorId, timestamp])
}

// =============================================================================
// 6. AI PERSISTENCE (SERVERLESS-SAFE STATE ENGINE)
// =============================================================================

model AiConfirmationSession {
  id              String             @id @default(cuid())
  token           String             @unique
  workspaceId     String
  userId          String
  planId          String
  planFingerprint String
  plan            Json
  actions         Json
  status          ConfirmationStatus @default(PENDING)
  expiresAt       DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([workspaceId, userId, status])
  @@index([expiresAt])
}

model AiConversation {
  id          String               @id @default(cuid())
  workspaceId String
  userId      String
  title       String               @default("AI Assistant Conversation")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns       AiConversationTurn[]

  @@index([workspaceId, userId, updatedAt])
}

model AiConversationTurn {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String         @db.Text
  intent         String?
  entities       Json?
  metadata       Json?
  createdAt      DateTime       @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AiExecutionReceipt {
  id           String    @id @default(cuid())
  executionId  String    @unique
  workspaceId  String
  userId       String
  planId       String
  actions      Json
  isReversible Boolean   @default(true)
  rolledBackAt DateTime?
  createdAt    DateTime  @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([workspaceId, userId, createdAt])
}
